# Server
PORT=3000
# Where the SQLite DB and uploaded media live (default: ./data)
DATA_DIR=./data
# Public URL used for OAuth callbacks (Last.fm)
PUBLIC_URL=http://localhost:3000
# Maximum upload size in MB
MAX_UPLOAD_MB=60
# Set to "production" behind HTTPS so the session cookie gets the Secure flag
NODE_ENV=development

# Optional integrations — leave blank to keep them off. Secrets stay on the server.
# AI playlist suggestions (Anthropic Messages API)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Last.fm scrobbling (official API + OAuth)
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
# Music recognition (AudD)
AUDD_API_TOKEN=
